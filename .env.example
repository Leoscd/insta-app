# ─────────────────────────────────────────────────────────────
# Plantilla de variables de entorno. Copiar a `.env` y completar.
# El archivo `.env` NUNCA se sube al repo (está en .gitignore).
# Estos valores equivalen a contraseñas: no compartir ni pegar en chats.
# ─────────────────────────────────────────────────────────────

# App "prueba-IG" en Meta for Developers.
# App ID y App Secret se ven en el panel de la app (Configuración > Básica),
# o en la pantalla del caso de uso de Instagram.
IG_APP_ID=1359112955658005
IG_APP_SECRET=

# Token de acceso. Pegá acá el token de CORTA duración que generás en el panel
# ("Generar tokens de acceso"). Luego corré `python scripts/refresh_token.py`
# para cambiarlo por uno de LARGA duración (60 días) — ese script te dice qué pegar.
IG_ACCESS_TOKEN=

# ID numérico de tu cuenta de Instagram. Si lo dejás vacío,
# `scripts/refresh_token.py` lo descubre y te lo imprime para pegar acá.
IG_USER_ID=

# Versión de la Graph API a usar (se puede subir cuando Meta publique una nueva).
IG_API_VERSION=v23.0

# ─────────────────────────────────────────────────────────────
# Opcional: etiquetado de tema asistido por IA (API de Claude).
# Si lo dejás vacío, el etiquetado por IA se desactiva y podés
# etiquetar manualmente desde el dashboard.
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Ruta de la base de datos SQLite (relativa a la raíz del proyecto).
DB_PATH=data/insta.db
